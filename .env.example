# ============================================================
# APPLICATION SETTINGS
# ============================================================
APP_NAME="Washioo - Car Washing Service"
APP_VERSION="1.0.0"
DEBUG=False
ENVIRONMENT=production
LOG_LEVEL=INFO

# ============================================================
# DATABASE CONFIGURATION
# ============================================================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
POSTGRES_USER=washioo_user
POSTGRES_PASSWORD=replace_with_a_strong_password
POSTGRES_DB=washioo_db
DATABASE_URL=postgresql://washioo_user:replace_with_a_strong_password@postgres:5432/washioo_db
TEST_DATABASE_URL=postgresql://washioo_test_user:replace_with_a_strong_password@localhost:5432/washioo_test
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=0
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_POOL_TIMEOUT_SECONDS=10

# ============================================================
# JWT CONFIGURATION
# ============================================================
# Generate a secret key: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Keep SECRET_KEY stable across redeploys. Changing it without PREVIOUS_SECRET_KEYS
# will invalidate existing access/refresh tokens and cause a mass logout.
SECRET_KEY=your-secret-key-here-generate-with-32-chars-minimum
# Optional comma-separated old keys during key rotation. When rotating, move the
# current SECRET_KEY here, set a new SECRET_KEY, and keep the old key here until
# all refresh tokens issued with it have expired.
PREVIOUS_SECRET_KEYS=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================
# OTP CONFIGURATION
# ============================================================
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5

# ============================================================
# RATE LIMITING
# ============================================================
RATE_LIMIT_ENABLED=True
SEND_OTP_RATE_LIMIT=3/15 minutes
SEND_OTP_IP_RATE_LIMIT=10/1 hour
AUTH_RATE_LIMIT=5/15 minutes
REFRESH_RATE_LIMIT=20/1 hour

# ============================================================
# SMSCOUNTRY CONFIGURATION
# ============================================================
SMS_COUNTRY_KEY=your_smscountry_account_key
SMS_COUNTRY_TOKEN=your_smscountry_auth_token
SMS_HEADER=AMBHPL

# ============================================================
# CORS CONFIGURATION
# ============================================================
# Use the exact frontend origins. Do not use "*" with CORS_CREDENTIALS=True.
CORS_ORIGINS=["https://your-frontend.example.com"]
CORS_CREDENTIALS=True
CORS_METHODS=["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"]
CORS_HEADERS=["*"]

# ============================================================
# FRONTEND URL
# ============================================================
FRONTEND_URL=http://localhost:3000

# ============================================================
# WEB PUSH NOTIFICATIONS
# ============================================================
# No paid third-party service is needed. Browsers route push messages through
# their own push services. Generate VAPID keys and keep the private key secret.
WEB_PUSH_ENABLED=True
WEB_PUSH_VAPID_PUBLIC_KEY=replace_with_vapid_public_key
WEB_PUSH_VAPID_PRIVATE_KEY=replace_with_vapid_private_key
WEB_PUSH_VAPID_SUBJECT=mailto:support@your-domain.com
